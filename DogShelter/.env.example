# ============================================================
# DogShelter – configuration template
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# --- Database ---
ConnectionStrings__DogShelter=Server=localhost;Database=180026;Trusted_Connection=True;TrustServerCertificate=True

# --- JWT ---
JWTSettings__Key=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS
JWTSettings__Issuer=DogShelterAPI
JWTSettings__Audience=DogShelterClient
JWTSettings__DurationInMinutes=60

# --- Admin seed ---
AdminSeed__UserName=admin
AdminSeed__Email=admin@dogshelter.ba
AdminSeed__Password=Admin123!

# --- CORS (comma-separated) ---
CORS__AllowedOrigins=http://localhost:5265,http://localhost:7224,http://10.0.2.2:5265

# --- Stripe ---
Stripe__SecretKey=sk_test_...
Stripe__PublishableKey=pk_test_...
Stripe__WebhookSecret=whsec_...
Stripe__Currency=eur

# --- RabbitMQ ---
RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# --- SMTP ---
SMTP__Host=smtp.gmail.com
SMTP__Port=587
SMTP__Username=your@email.com
SMTP__Password=your-app-password
SMTP__UseSsl=true
SMTP__SenderName=DogShelter
